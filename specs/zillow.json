            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Map bounds for tiling past the 820 cap",
              "title": "North"
            },
            "description": "Map bounds for tiling past the 820 cap"
          },
          {
            "name": "south",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
